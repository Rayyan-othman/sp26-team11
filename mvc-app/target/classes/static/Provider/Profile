<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AutoBid | Provider Profile</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; background: linear-gradient(180deg, #081223 0%, #0b1220 100%); color: #e8edf7; min-height: 100vh; }
        .layout { display: flex; min-height: 100vh; }
        .sidebar { width: 260px; background: linear-gradient(180deg, #0e1930 0%, #0a1324 100%); border-right: 1px solid rgba(255,255,255,0.08); padding: 24px 18px; display: flex; flex-direction: column; justify-content: space-between; }
        .brand { display: flex; align-items: center; gap: 14px; margin-bottom: 28px; }
        .brand-icon { width: 48px; height: 48px; border-radius: 14px; background: rgba(255,255,255,0.12); display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 24px; }
        .brand-text h1 { font-size: 18px; margin-bottom: 4px; }
        .brand-text p { font-size: 14px; color: #a9b7d0; }
        .nav { display: flex; flex-direction: column; gap: 10px; }
        .nav a { text-decoration: none; color: #d8e1f0; padding: 14px; border-radius: 14px; transition: 0.2s ease; }
        .nav a.active, .nav a:hover { background: rgba(255,255,255,0.10); }
        .user-box, .logout-btn { width: 100%; border-radius: 16px; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.06); color: #e8edf7; padding: 16px; }
        .user-box { margin-bottom: 14px; }
        .user-box .name { font-size: 16px; font-weight: bold; margin-bottom: 4px; }
        .user-box .email { color: #a9b7d0; font-size: 14px; }
        .logout-btn { cursor: pointer; font-size: 16px; }
        .main { flex: 1; padding: 28px; }
        .page-title { font-size: 34px; margin-bottom: 8px; }
        .page-subtitle { color: #b3c0d7; margin-bottom: 28px; font-size: 16px; }
        .panel { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08); border-radius: 20px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.18); max-width: 600px; }
        .panel-header { padding: 20px 22px; border-bottom: 1px solid rgba(255,255,255,0.08); }
        .panel-header h2 { font-size: 18px; }
        .form-body { padding: 24px 22px; }
        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-size: 13px; color: #a9b7d0; margin-bottom: 6px; }
        .form-group input, .form-group select { width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15); border-radius: 10px; color: #e8edf7; font-size: 14px; }
        .form-group input::placeholder { color: #6a7d99; }
        .btn-submit { padding: 12px 28px; background: #1a7a4a; color: white; border: none; border-radius: 10px; cursor: pointer; font-size: 14px; font-weight: 600; }
        .msg { display:none; margin-bottom: 16px; font-size: 14px; padding: 10px 14px; border-radius: 10px; }
    </style>
</head>
<body>
<div class="layout">
    <aside class="sidebar">
        <div>
            <div class="brand">
                <div class="brand-icon">AB</div>
                <div class="brand-text"><h1>AutoBid</h1><p>Provider Portal</p></div>
            </div>
            <nav class="nav">
                <a href="./dashboard.html">Dashboard</a>
                <a href="./dashboard.html#servicesPanel">My Services</a>
                <a href="./dashboard.html#reviewsPanel">Reviews</a>
                <a href="./profile.html" class="active">Profile</a>
            </nav>
        </div>
        <div class="sidebar-footer">
            <div class="user-box">
                <div class="name" id="sidebarName">Provider</div>
                <div class="email" id="sidebarEmail">provider@autobid.com</div>
            </div>
            <button class="logout-btn" type="button" onclick="logout()">Log out</button>
        </div>
    </aside>

    <main class="main">
        <h1 class="page-title">My Profile</h1>
        <p class="page-subtitle">Update your account information.</p>

        <div class="panel">
            <div class="panel-header"><h2>Account Details</h2></div>
            <div class="form-body">
                <div id="msg" class="msg"></div>
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" id="name" placeholder="Your full name">
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" id="email" placeholder="your@email.com">
                </div>
                <div class="form-group">
                    <label>New Password <span style="color:#6a7d99; font-weight:normal;">(leave blank to keep current)</span></label>
                    <input type="password" id="password" placeholder="New password">
                </div>
                <div class="form-group">
                    <label>Account Status</label>
                    <select id="accountStatus">
                        <option value="ACTIVE">Active</option>
                        <option value="INACTIVE">Inactive</option>
                    </select>
                </div>
                <button class="btn-submit" type="button" onclick="saveProfile()">Save Changes</button>
            </div>
        </div>
    </main>
</div>

<script>
    const API_BASE = "http://localhost:8080";
    let currentUser = null;

    function logout() {
        localStorage.removeItem("currentUser");
        window.location.href = "../Auth/login.html";
    }

    function showMsg(text, ok) {
        const el = document.getElementById("msg");
        el.style.display = "block";
        el.style.color = ok ? "#a8f0cc" : "#ffb4b4";
        el.textContent = text;
    }

    function init() {
        const stored = localStorage.getItem("currentUser");
        if (!stored) { window.location.href = "../Auth/login.html"; return; }
        currentUser = JSON.parse(stored);
        document.getElementById("sidebarName").textContent = currentUser.name || "Provider";
        document.getElementById("sidebarEmail").textContent = currentUser.email || "";
        document.getElementById("name").value = currentUser.name || "";
        document.getElementById("email").value = currentUser.email || "";
        document.getElementById("accountStatus").value = currentUser.accountStatus || "ACTIVE";
    }

    async function saveProfile() {
        const name = document.getElementById("name").value.trim();
        const email = document.getElementById("email").value.trim();
        const password = document.getElementById("password").value;
        const accountStatus = document.getElementById("accountStatus").value;

        if (!name || !email) { showMsg("Name and email are required.", false); return; }

        const payload = { name, email, role: "PROVIDER", accountStatus };
        if (password) payload.password = password;

        try {
            const res = await fetch(`${API_BASE}/admin/users/${currentUser.id}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            if (!res.ok) throw new Error(await res.text());
            const updated = await res.json();
            localStorage.setItem("currentUser", JSON.stringify({ id: updated.id, name: updated.name, email: updated.email, role: updated.role, accountStatus: updated.accountStatus }));
            currentUser = updated;
            document.getElementById("sidebarName").textContent = updated.name;
            document.getElementById("sidebarEmail").textContent = updated.email;
            showMsg("Profile updated successfully!", true);
        } catch(e) {
            showMsg("Error: " + e.message, false);
        }
    }

    init();
</script>
</body>
</html>